        "review": "",
        "images": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "rating": [
            "Rating must be between 1 and 5"
          ]
        }
      '''
    }
  }
}

