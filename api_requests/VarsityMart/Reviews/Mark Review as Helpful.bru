meta {
  name: Mark Review as Helpful
  type: http
  seq: 4
  tags: [
    Reviews
  ]
}

post {
  url: {{baseUrl}}/v1/reviews/:id/helpful/
  body: none
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  
          Mark a review as helpful.
  
          ### Requirements:
          - **Authentication**: User must be logged in
          - **One mark per user**: Each user can only mark a review as helpful once
  
          ### What Happens:
          1. A helpful record is created linking the user to the review
          2. The review's helpful counter is incremented by 1
          3. Returns the updated helpful count
  
          ### Duplicate Prevention:
          If the user has already marked this review as helpful, a **400** error is returned.
          
}

example {
  name: 200 Response
  description: Review marked as helpful
  
  request: {
    url: {{baseUrl}}/v1/reviews/:id/helpful/
    method: POST
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/reviews/:id/helpful/
    method: POST
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "You have already marked this review as helpful"
        }
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
