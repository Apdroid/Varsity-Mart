  ]
}

get {
  url: {{baseUrl}}/v1/payments/escrow/balance
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Get escrow balance and transaction history for sellers
}

