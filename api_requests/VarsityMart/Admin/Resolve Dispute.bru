meta {
  name: Resolve Dispute
  type: http
  seq: 4
  tags: [
    Admin
    Disputes
  ]
}

post {
  url: {{baseUrl}}/v1/admin/disputes/:dispute_id/resolve/
  body: json
  auth: apikey
}

params:path {
  dispute_id: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "resolution": "buyer_win",
    "refundAmount": 99.99,
    "notes": "Item was damaged during shipping"
  }
}

docs {
  Resolve an open dispute by determining resolution and issuing refund if applicable
}

example {
  name: 201 Response
  description: Dispute resolved successfully
  
  request: {
    url: {{baseUrl}}/v1/admin/disputes/:dispute_id/resolve/
    method: POST
    mode: json
    params:path: {
      dispute_id: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "resolution": "buyer_win",
        "refundAmount": 99.99,
        "notes": "Item was damaged during shipping"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Dispute resolved",
          "data": {
            "disputeId": "",
            "resolution": "",
            "refundAmount": 0
          }
        }
      '''
    }
  }
}

