meta {
  name: Get Admin Products
  type: http
  seq: 9
  tags: [
    Admin
    Products
  ]
}

get {
  url: {{baseUrl}}/v1/admin/products/
  body: none
  auth: apikey
}

params:query {
  limit: 10
  page: 1
  ~category: 
  ~search: 
  ~status: active
  ~status: inactive
  ~status: sold
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Retrieve all products with stat counts and optional filtering by category or status.
}

example {
  name: 200 Response
  description: Products retrieved successfully
  
  request: {
    url: {{baseUrl}}/v1/admin/products/
    method: GET
    mode: none
    params:query: {
      ~category: 
      limit: 10
      page: 1
      ~search: 
      ~status: active
      ~status: inactive
      ~status: sold
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "stats": {
              "total": 0,
              "active": 0,
              "inactive": 0,
              "avgPrice": 0
            },
            "products": [
              {
                "id": "",
                "title": "Jollof Rice (Large)",
                "store": "QuickBite GH",
                "category": "Food",
                "price": 28,
                "stock": 42,
                "stockStatus": "active",
                "status": "active",
                "campus": "KNUST",
                "approvalStatus": "approved"
              }
            ],
            "pagination": {
              "currentPage": 0,
              "totalPages": 0,
              "totalItems": 0
            }
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided
  
  request: {
    url: {{baseUrl}}/v1/admin/products/
    method: GET
    mode: none
    params:query: {
      ~category: 
      limit: 10
      page: 1
      ~search: 
      ~status: active
      ~status: inactive
      ~status: sold
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Admin permission required
  
  request: {
    url: {{baseUrl}}/v1/admin/products/
    method: GET
    mode: none
    params:query: {
      ~category: 
      limit: 10
      page: 1
      ~search: 
      ~status: active
      ~status: inactive
      ~status: sold
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
