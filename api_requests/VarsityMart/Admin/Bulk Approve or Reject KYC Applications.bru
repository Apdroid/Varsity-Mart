meta {
  name: Bulk Approve or Reject KYC Applications
  type: http
  seq: 8
  tags: [
    Admin
  ]
}

post {
  url: {{baseUrl}}/v1/admin/kyc/bulk-action/
  body: json
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "user_ids": [],
    "action": "approve",
    "notes": ""
  }
}

docs {
  
          Bulk action on up to 50 KYC applications.
  
          Users already at the target status are skipped (not counted as failures).
          Emails are sent asynchronously via Celery.
          
}

example {
  name: 200 Response
  description: Bulk action completed
  
  request: {
    url: {{baseUrl}}/v1/admin/kyc/bulk-action/
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "user_ids": [],
        "action": "approve",
        "notes": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

