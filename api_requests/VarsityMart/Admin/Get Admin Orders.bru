meta {
  name: Get Admin Orders
  type: http
  seq: 8
  tags: [
    Admin
    Orders
  ]
}

get {
  url: {{baseUrl}}/v1/admin/orders/
  body: none
  auth: apikey
}

params:query {
  limit: 10
  page: 1
  ~export: 
  ~status: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Retrieve all orders with stat counts and optional filtering by status. Pass ?export=csv to download as CSV.
}

example {
  name: 200 Response
  description: Orders retrieved successfully
  
  request: {
    url: {{baseUrl}}/v1/admin/orders/
    method: GET
    mode: none
    params:query: {
      ~export: 
      limit: 10
      page: 1
      ~status: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "stats": {
              "total": 0,
              "delivered": 0,
              "pending": 0,
              "cancelled": 0
            },
            "orders": [
              {
                "orderId": "ORD-20260101-ABCD",
                "customer": "Kwame Mensah",
                "customerAvatar": "",
                "store": "Campus Eats",
                "qty": 2,
                "amount": 45.5,
                "status": "delivered",
                "deliveryMethod": "campus_delivery",
                "date": "Apr 29"
              }
            ],
            "pagination": {
              "currentPage": 0,
              "totalPages": 0,
              "totalItems": 0
            }
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided
  
  request: {
    url: {{baseUrl}}/v1/admin/orders/
    method: GET
    mode: none
    params:query: {
      ~export: 
      limit: 10
      page: 1
      ~status: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Admin permission required
  
  request: {
    url: {{baseUrl}}/v1/admin/orders/
    method: GET
    mode: none
    params:query: {
      ~export: 
      limit: 10
      page: 1
      ~status: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
