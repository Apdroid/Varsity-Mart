meta {
  name: Get KYC Statistics
  type: http
  seq: 9
  tags: [
    Admin
  ]
}

get {
  url: {{baseUrl}}/v1/admin/kyc/stats/
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Returns aggregated KYC statistics and metrics.
}

example {
  name: 200 Response
  description: KYC statistics
  
  request: {
    url: {{baseUrl}}/v1/admin/kyc/stats/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided.
  
  request: {
    url: {{baseUrl}}/v1/admin/kyc/stats/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: You do not have permission to perform this action.
  
  request: {
    url: {{baseUrl}}/v1/admin/kyc/stats/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
