meta {
  name: Review Product Listing
  type: http
  seq: 5
  tags: [
    Admin
    Listings
  ]
}

post {
  url: {{baseUrl}}/v1/admin/listings/:listing_id/review/
  body: json
  auth: apikey
}

params:path {
  listing_id: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "action": "approve",
    "notes": "Listing meets all requirements"
  }
}

docs {
  Review and approve or reject a product listing
}

example {
  name: 201 Response
  description: Listing reviewed successfully
  
  request: {
    url: {{baseUrl}}/v1/admin/listings/:listing_id/review/
    method: POST
    mode: json
    params:path: {
      listing_id: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "action": "approve",
        "notes": "Listing meets all requirements"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Listing reviewed",
          "data": {
            "listingId": "",
            "status": "approve"
          }
        }
      '''
    }
  }
}

