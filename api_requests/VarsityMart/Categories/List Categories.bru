meta {
  name: List Categories
  type: http
  seq: 1
  tags: [
    Categories
  ]
}

get {
  url: {{baseUrl}}/v1/restaurant-categories/
  body: none
  auth: apikey
}

params:query {
  ~page: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Retrieve all food categories available on the platform.
}

example {
  name: 200 Response
  description: Categories retrieved successfully
  
  request: {
    url: {{baseUrl}}/v1/restaurant-categories/
    method: GET
    mode: none
    params:query: {
      ~page: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "count": 123,
          "next": "http://api.example.org/accounts/?page=4",
          "previous": "http://api.example.org/accounts/?page=2",
          "results": [
            {
              "success": true,
              "data": {
                "categories": [
                  {}
                ]
              }
            }
          ]
        }
      '''
    }
  }
}
