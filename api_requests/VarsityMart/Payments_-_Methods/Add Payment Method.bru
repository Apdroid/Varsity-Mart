meta {
  name: Add Payment Method
  type: http
  seq: 2
  tags: [
    Payments_-_Methods
  ]
}

post {
  url: {{baseUrl}}/v1/payments/methods
  body: json
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "type": "",
    "provider": "",
    "number": "",
    "name": "",
    "bank_code": "",
    "is_default": false
  }
}

docs {
  Add a new payment method (MoMo, Card, or Bank)
}

example {
  name: 201 Response
  description: Payment method added
  
  request: {
    url: {{baseUrl}}/v1/payments/methods
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "type": "",
        "provider": "",
        "number": "",
        "name": "",
        "bank_code": "",
        "is_default": false
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 400 Response
  description: Validation error
  
  request: {
    url: {{baseUrl}}/v1/payments/methods
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "type": "",
        "provider": "",
        "number": "",
        "name": "",
        "bank_code": "",
        "is_default": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
