meta {
  name: Get Payment Methods
  type: http
  seq: 1
  tags: [
    Payments_-_Methods
  ]
}

get {
  url: {{baseUrl}}/v1/payments/methods
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Get all payment methods for the authenticated user
}

example {
  name: 200 Response
  description: Payment methods retrieved
  
  request: {
    url: {{baseUrl}}/v1/payments/methods
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
