meta {
  name: Delete Payment Method
  type: http
  seq: 3
  tags: [
    Payments_-_Methods
  ]
}

delete {
  url: {{baseUrl}}/v1/payments/methods/:methodId
  body: none
  auth: apikey
}

params:path {
  methodId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Delete a payment method
}

example {
  name: 200 Response
  description: Payment method removed
  
  request: {
    url: {{baseUrl}}/v1/payments/methods/:methodId
    method: DELETE
    mode: none
    params:path: {
      methodId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: Payment method not found
  
  request: {
    url: {{baseUrl}}/v1/payments/methods/:methodId
    method: DELETE
    mode: none
    params:path: {
      methodId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
