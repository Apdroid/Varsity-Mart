meta {
  name: Toggle Product Like
  type: http
  seq: 7
  tags: [
    Products
  ]
}

post {
  url: {{baseUrl}}/v1/products/:id/like/
  body: none
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  
          Toggle the like status on a product.
  
          ### Behavior:
          - If the user has **not liked** the product, a like is created and the like count increases
          - If the user has **already liked** the product, the like is removed and the count decreases
  
          ### Requirements:
          - **Authentication**: User must be logged in
          
}

example {
  name: 200 Response
  description: Like toggled successfully
  
  request: {
    url: {{baseUrl}}/v1/products/:id/like/
    method: POST
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

