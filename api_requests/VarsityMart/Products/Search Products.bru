meta {
  name: Search Products
  type: http
  seq: 10
  tags: [
    Products
  ]
}

get {
  url: {{baseUrl}}/v1/products/search/
  body: none
  auth: inherit
}

params:query {
  campus: Legon
  q: 
  university: University of Ghana
  ~limit: 
  ~page: 
}

docs {
  
          Search for products by title or description.
  
          ### Features:
          - **Full-text search**: Searches across product title and description fields
          - **Pagination**: Results are paginated (default 20 per page)
          - **Case-insensitive**: Search is case-insensitive
  
          ### Public Access:
          This endpoint is publicly accessible — no authentication required.
          
}

