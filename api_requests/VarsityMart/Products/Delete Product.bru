meta {
  name: Delete Product
  type: http
  seq: 6
  tags: [
    Products
  ]
}

delete {
  url: {{baseUrl}}/v1/products/:id/
  body: none
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  
          Delete a product listing from the marketplace.
  
          ### Requirements:
          - **Authentication**: User must be logged in
          - **Ownership**: Only the product seller can delete their product
  
          ### What Happens:
          - The product and all associated images are permanently removed
          - Cloudinary images are cleaned up via the model's delete signal
          
}

