meta {
  name: Partially Update Product
  type: http
  seq: 5
  tags: [
    Products
  ]
}

patch {
  url: {{baseUrl}}/v1/products/:id/
  body: multipartForm
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  id: 
  title: 
  description: 
  price: 
  original_price: 
  category: 
  condition: N
  location: 
  stock: 
  delivery_options: 
  images: 
  specifications: 
  is_night_shop: 
  status: 
}

docs {
  
          Partially update an existing product listing.
  
          ### Requirements:
          - **Authentication**: User must be logged in
          - **Ownership**: Only the product seller can update their product
  
          ### Note:
          Only the fields provided in the request body will be updated. All other fields remain unchanged.
          
}

example {
  name: 200 Response
  description: Product updated successfully
  
  request: {
    url: {{baseUrl}}/v1/products/:id/
    method: PATCH
    mode: multipartForm
    params:path: {
      id: 
    }
  
    body:multipart-form: {
      id: 
      title: 
      description: 
      price: 
      original_price: 
      category: 
      condition: N
      location: 
      stock: 
      delivery_options: 
      images: 
      specifications: 
      is_night_shop: 
      status: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

