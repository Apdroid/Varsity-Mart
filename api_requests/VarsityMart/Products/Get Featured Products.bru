meta {
  name: Get Featured Products
  type: http
  seq: 8
  tags: [
    Products
  ]
}

get {
  url: {{baseUrl}}/v1/products/featured/
  body: none
  auth: inherit
}

params:query {
  campus: Legon
  university: University of Ghana
}

docs {
  Returns up to 10 featured products selected from the top 15 by rating and likes, shuffled on every request.
}

