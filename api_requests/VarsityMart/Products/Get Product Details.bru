meta {
  name: Get Product Details
  type: http
  seq: 3
  tags: [
    Products
  ]
}

get {
  url: {{baseUrl}}/v1/products/:id/
  body: none
  auth: inherit
}

params:path {
  id: e14963f1-88dd-467d-ae84-1f7778ecd1c9
}

docs {
  
          Retrieve detailed information about a specific product by its ID.
  
          ### Features:
          - **View Counter**: Each request increments the product's view count
          - **Seller Details**: Includes extended seller info (total sales, response rate, response time)
          - **Like Status**: Shows whether the authenticated user has liked the product
          - **Delivery Options**: Returns available delivery methods
          - **Specifications**: Returns product specifications
  
          ### Public Access:
          This endpoint is publicly accessible — no authentication required.
          
}

