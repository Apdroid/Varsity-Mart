example {
  name: 403 Response
  description: Permission denied - Not the buyer or user not verified
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/rate
    method: POST
    mode: json
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "rating": 0,
        "review": "",
        "rateProduct": false,
        "rateSeller": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Only the buyer can rate this order"
        }
      '''
    }
  }
}

