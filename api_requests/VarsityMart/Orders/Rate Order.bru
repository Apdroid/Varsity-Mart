example {
  name: Order already rated
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/rate
    method: POST
    mode: json
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "rating": 0,
        "review": "",
        "rateProduct": false,
        "rateSeller": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
