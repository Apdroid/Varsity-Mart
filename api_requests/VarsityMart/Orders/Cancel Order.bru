meta {
  name: Cancel Order
  type: http
  seq: 2
  tags: [
    Orders
  ]
}

post {
  url: {{baseUrl}}/v1/orders/:orderId/cancel
  body: json
  auth: apikey
}

params:path {
  orderId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "reason": "",
    "details": ""
  }
}

docs {
  Cancel an order. Both buyer and seller can cancel orders, but with different restrictions based on order status and timing.
}

example {
  name: 200 Response
  description: Order cancelled successfully
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/cancel
    method: POST
    mode: json
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "reason": "",
        "details": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Order cancelled successfully. Refund initiated.",
          "data": {
            "orderId": "ORD-20231201-ABCDEF",
            "status": "cancelled",
            "refundStatus": "pending",
            "refundAmount": 99.99
          }
        }
      '''
    }
  }
}

