example {
  name: 409 Response
  description: Conflict - Order cannot be cancelled in current status
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/cancel
    method: POST
    mode: json
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "reason": "",
        "details": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Order cannot be cancelled in delivered status"
        }
      '''
    }
  }
}
