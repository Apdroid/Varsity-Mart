    url: {{baseUrl}}/v1/orders/my-orders
    method: GET
    mode: none
    params:query: {
      limit: 20
      page: 1
      ~status: cancelled
      ~status: delivered
      ~status: pending
      ~status: processing
      ~status: shipped
      type: buyer
      ~type: seller
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: User account is not verified
  
  request: {
    url: {{baseUrl}}/v1/orders/my-orders
    method: GET
    mode: none
    params:query: {
      limit: 20
      page: 1
      ~status: cancelled
      ~status: delivered
      ~status: pending
      ~status: processing
      ~status: shipped
      type: buyer
      ~type: seller
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
