meta {
  name: Confirm Order Delivery
  type: http
  seq: 3
  tags: [
    Orders
  ]
}

post {
  url: {{baseUrl}}/v1/orders/:orderId/confirm-delivery
  body: none
  auth: apikey
}

params:path {
  orderId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  
  Confirm delivery of an order as the buyer and release escrow funds.
  
  Only the buyer can call this endpoint. The order must be in a deliverable state and satisfy
  business checks (`can_confirm_delivery`) before confirmation proceeds.
  
  Side effects:
  - Order transitions to delivered via `confirm_delivery()`
  - Escrow moves from held to released for eligible paid orders
  - Response includes updated order and escrow status
  
  If preconditions are not met, the endpoint returns a 400 response with explanatory context,
  including auto-confirmation related timing details where applicable.
          
}

example {
  name: Delivery confirmed and escrow released
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/confirm-delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Order delivery confirmed. Escrow released to seller.",
          "data": {
            "orderId": "ORD-20260511-Q7W8E9",
            "status": "delivered",
            "escrowStatus": "released"
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad request - Order cannot be confirmed in current status
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/confirm-delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Order cannot be confirmed in pending status"
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication required
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/confirm-delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": "Authentication credentials were not provided."
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Permission denied - Not the buyer or user not verified
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/confirm-delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Only the buyer can confirm delivery"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Order not found
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/confirm-delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": "Not found."
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Conflict - Auto-confirmation period not elapsed
  
  request: {
    url: {{baseUrl}}/v1/orders/:orderId/confirm-delivery
    method: POST
    mode: none
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Delivery confirmation not available. Auto-confirmation in 3 days.",
          "data": {
            "autoConfirmDate": "2023-12-08T10:30:00Z"
          }
        }
      '''
    }
  }
}
