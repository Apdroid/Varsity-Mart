get {
  url: {{baseUrl}}/v1/conversations/:id/messages/
  body: none
  auth: apikey
}

params:query {
  ~limit: 
  ~page: 
}

params:path {
  id: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/v1/conversations/:id/messages/
