example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/product-images/:id/
    method: DELETE
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
