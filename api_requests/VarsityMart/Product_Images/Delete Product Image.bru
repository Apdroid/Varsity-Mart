meta {
  name: Delete Product Image
  type: http
  seq: 2
  tags: [
    Product_Images
  ]
}

delete {
  url: {{baseUrl}}/v1/product-images/:id/
  body: none
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  
          Delete a specific product image.
  
          ### Requirements:
          - **Authentication**: User must be logged in
          - **Ownership**: Only the product owner can delete images
  
          ### What Happens:
          - The image is removed from Cloudinary via the model's delete signal
          - The database record is permanently deleted
          
}

