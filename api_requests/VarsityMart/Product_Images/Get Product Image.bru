meta {
  name: Get Product Image
  type: http
  seq: 1
  tags: [
    Product_Images
  ]
}

get {
  url: {{baseUrl}}/v1/product-images/:id/
  body: none
  auth: bearer
}

params:path {
  id: 1f78cfe3-2a9d-44b0-926e-da25a172bafb
}

auth:bearer {
  token: {{token}}
}

docs {
  
          Retrieve details for a specific product image by its ID.
  
          ### Requirements:
          - **Authentication**: User must be logged in
  
          ### Response:
          Returns image URLs (original, thumbnail, optimized), dimensions, format, and display order.
          
}

