meta {
  name: Update Food Order Status
  type: http
  seq: 5
  tags: [
    Food_Orders
  ]
}

patch {
  url: {{baseUrl}}/v1/food-orders/:orderId/status
  body: json
  auth: apikey
}

params:path {
  orderId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "status": "pending_payment",
    "estimatedDeliveryTime": ""
  }
}

docs {
  Update the status of a food order. Only the restaurant owner can update order status. Updates status and creates a timeline entry.
}

example {
  name: 200 Response
  description: Order status updated successfully
  
  request: {
    url: {{baseUrl}}/v1/food-orders/:orderId/status
    method: PATCH
    mode: json
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "status": "pending_payment",
        "estimatedDeliveryTime": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Order status updated",
          "data": {
            "orderId": "",
            "status": ""
          }
        }
      '''
    }
  }
}

