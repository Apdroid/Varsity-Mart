meta {
  name: Create Food Order
  type: http
  seq: 1
  tags: [
    Food_Orders
  ]
}

post {
  url: {{baseUrl}}/v1/food-orders/
  body: json
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "restaurantId": "",
    "items": [
      {
        "itemId": "",
        "quantity": 0,
        "customizations": [
          {}
        ],
        "specialInstructions": ""
      }
    ],
    "deliveryMethod": "campus_delivery",
    "deliveryAddress": "",
    "deliveryInstructions": "",
    "paymentMethod": "",
    "momoNumber": "",
    "momoProvider": ""
  }
}

docs {
  Create a new food order. Calculates subtotal, delivery fee, and service fee automatically. Returns payment URL for checkout.
}

example {
  name: 201 Response
  description: Food order created successfully
  
  request: {
    url: {{baseUrl}}/v1/food-orders
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "restaurantId": "",
        "items": [
          {
            "itemId": "",
            "quantity": 0,
            "customizations": [
              {}
            ],
            "specialInstructions": ""
          }
        ],
        "deliveryMethod": "campus_delivery",
        "deliveryAddress": "",
        "deliveryInstructions": "",
        "paymentMethod": "",
        "momoNumber": "",
        "momoProvider": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Food order placed successfully",
          "data": {
            "orderId": "FOOD-ORD-20260115-ABCDEF",
            "status": "pending_payment",
            "subtotal": 0,
            "deliveryFee": 0,
            "serviceFee": 0,
            "total": 0,
            "estimatedDelivery": "",
            "paymentUrl": ""
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Validation failed or order creation error
  
  request: {
    url: {{baseUrl}}/v1/food-orders
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "restaurantId": "",
