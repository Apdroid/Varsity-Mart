          {
            "itemId": "",
            "quantity": 0,
            "customizations": [
              {}
            ],
            "specialInstructions": ""
          }
        ],
        "deliveryMethod": "campus_delivery",
        "deliveryAddress": "",
        "deliveryInstructions": "",
        "paymentMethod": "",
        "momoNumber": "",
        "momoProvider": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": {}
        }
      '''
    }
  }
}

