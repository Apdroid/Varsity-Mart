meta {
  name: Rate Food Order
  type: http
  seq: 4
  tags: [
    Food_Orders
  ]
}

post {
  url: {{baseUrl}}/v1/food-orders/:orderId/rate
  body: json
  auth: apikey
}

params:path {
  orderId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "rating": 0,
    "review": "",
    "foodQuality": 0,
    "deliverySpeed": 0,
    "packaging": 0
  }
}

docs {
  Submit a rating and review for a completed food order. Only customers can rate their orders. Order must be delivered.
}

example {
  name: 200 Response
  description: Review submitted successfully
  
  request: {
    url: {{baseUrl}}/v1/food-orders/:orderId/rate
    method: POST
    mode: json
    params:path: {
      orderId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "rating": 0,
        "review": "",
        "foodQuality": 0,
        "deliverySpeed": 0,
        "packaging": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Thank you for your review!",
          "data": {
            "reviewId": ""
          }
        }
      '''
    }
  }
}

