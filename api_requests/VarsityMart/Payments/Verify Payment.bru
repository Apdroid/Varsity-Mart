meta {
  name: Verify Payment
  type: http
  seq: 1
  tags: [
    Payments
  ]
}

get {
  url: {{baseUrl}}/v1/payments/:paymentId/verify
  body: none
  auth: apikey
}

params:path {
  paymentId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Verify payment status by payment ID
}

example {
  name: 200 Response
  description: Payment status retrieved
  
  request: {
    url: {{baseUrl}}/v1/payments/:paymentId/verify
    method: GET
    mode: none
    params:path: {
      paymentId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: Payment not found
  
  request: {
    url: {{baseUrl}}/v1/payments/:paymentId/verify
    method: GET
    mode: none
    params:path: {
      paymentId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
