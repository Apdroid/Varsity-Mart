meta {
  name: Initiate Payment
  type: http
  seq: 2
  tags: [
    Payments
  ]
}

post {
  url: {{baseUrl}}/v1/payments/initiate
  body: json
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "type": "",
    "reference_id": "",
    "payment_method": "",
    "momo_number": "",
    "momo_provider": ""
  }
}

docs {
  Initiate a payment for order, subscription, or food order
}

example {
  name: 201 Response
  description: Payment initiated successfully
  
  request: {
    url: {{baseUrl}}/v1/payments/initiate
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "type": "",
        "reference_id": "",
        "payment_method": "",
        "momo_number": "",
        "momo_provider": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Payment initiated",
          "data": {
            "paymentId": "pay_260312123456",
            "status": "pending",
            "authorizationUrl": "https://checkout.paystack.com/xyz123",
            "accessCode": "xyz123abc",
            "expiresAt": "2026-03-13T05:05:00Z"
          }
        }
      '''
    }
  }
}

