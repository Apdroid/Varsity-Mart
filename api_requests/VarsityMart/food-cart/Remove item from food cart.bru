    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Cart item not found
  
  request: {
    url: {{baseUrl}}/v1/food-cart/:itemId/remove/
    method: DELETE
    mode: none
    params:path: {
      itemId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
