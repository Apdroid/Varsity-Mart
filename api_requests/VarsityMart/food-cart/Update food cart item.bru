meta {
  name: Update food cart item
  type: http
  seq: 2
  tags: [
    food-cart
  ]
}

patch {
  url: {{baseUrl}}/v1/food-cart/:itemId/
  body: json
  auth: apikey
}

params:path {
  itemId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "quantity": 0,
    "customizations": {},
    "specialInstructions": ""
  }
}

docs {
  Update quantity or customizations for a specific cart item
}

example {
  name: 200 Response
  description: Cart item updated successfully
  
  request: {
    url: {{baseUrl}}/v1/food-cart/:itemId/
    method: PATCH
    mode: json
    params:path: {
      itemId: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "quantity": 0,
        "customizations": {},
        "specialInstructions": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

