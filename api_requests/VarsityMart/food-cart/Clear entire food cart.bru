meta {
  name: Clear entire food cart
  type: http
  seq: 6
  tags: [
    food-cart
  ]
}

delete {
  url: {{baseUrl}}/v1/food-cart/clear/
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  Remove all items from the user's food cart
}

example {
  name: 200 Response
  description: Cart cleared successfully
  
  request: {
    url: {{baseUrl}}/v1/food-cart/clear/
    method: DELETE
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided
  
  request: {
    url: {{baseUrl}}/v1/food-cart/clear/
    method: DELETE
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: User account is not verified
  
  request: {
    url: {{baseUrl}}/v1/food-cart/clear/
    method: DELETE
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
