meta {
  name: Request Payout
  type: http
  seq: 2
  tags: [
    Payments_-_Payouts
  ]
}

post {
  url: {{baseUrl}}/v1/payments/payout
  body: json
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "amount": "",
    "payment_method": ""
  }
}

docs {
  Request a payout from released escrow funds
}

example {
  name: 201 Response
  description: Payout requested
  
  request: {
    url: {{baseUrl}}/v1/payments/payout
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "amount": "",
        "payment_method": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 400 Response
  description: Validation error or insufficient funds
  
  request: {
    url: {{baseUrl}}/v1/payments/payout
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "amount": "",
        "payment_method": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
