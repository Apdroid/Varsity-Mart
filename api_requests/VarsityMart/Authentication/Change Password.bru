meta {
  name: Change Password
  type: http
  seq: 1
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/v1/auth/change-password/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "OldPassword123!",
    "newPassword": "NewPassword456!",
    "confirmPassword": "NewPassword456!"
  }
}

docs {
  
  Change the authenticated user's password.
  
  ### Requirements:
  - User must be authenticated and verified
  - Google OAuth users cannot use this endpoint
  - Current password must be correct
  - New password must pass Django password validators
  - New password must differ from current password
  - All existing sessions are invalidated after change
  
  ### Side effects:
  - All JWT tokens are blacklisted
  - Auth cookies are cleared
  - User must log in again with the new password
          
}

example {
  name: 200 Response
  description: Password changed successfully
  
  request: {
    url: {{baseUrl}}/v1/auth/change-password/
    method: POST
    mode: json
    body:json: {
      {
        "currentPassword": "OldPassword123!",
        "newPassword": "NewPassword456!",
        "confirmPassword": "NewPassword456!"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Password changed successfully. Please log in again."
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Validation failed
  
  request: {
    url: {{baseUrl}}/v1/auth/change-password/
    method: POST
    mode: json
    body:json: {
      {
        "currentPassword": "OldPassword123!",
        "newPassword": "NewPassword456!",
        "confirmPassword": "NewPassword456!"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Validation failed",
          "errors": {}
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication required
  
  request: {
    url: {{baseUrl}}/v1/auth/change-password/
    method: POST
    mode: json
    body:json: {
      {
        "currentPassword": "OldPassword123!",
        "newPassword": "NewPassword456!",
        "confirmPassword": "NewPassword456!"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Google OAuth users cannot change password
  
  request: {
    url: {{baseUrl}}/v1/auth/change-password/
    method: POST
    mode: json
    body:json: {
      {
        "currentPassword": "OldPassword123!",
        "newPassword": "NewPassword456!",
        "confirmPassword": "NewPassword456!"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Google sign-in accounts do not have a password to change."
        }
      '''
    }
  }
}
