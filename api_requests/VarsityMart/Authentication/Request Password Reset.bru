meta {
  name: Request Password Reset
  type: http
  seq: 2
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/v1/auth/forgot-password/
  body: json
  auth: inherit
}

body:json {
  {
    "email": "marvelousajao06@gmail.com"
  }
}

docs {
  
          Request a password reset link to be sent to the user's email address.
          
          ### Process:
          1. User provides registered email address
          2. System generates unique reset token (valid for 24 hours)
          3. Reset link with token is sent to the email
          4. User clicks link to reset password
          
          ### Security Features:
          - Reset tokens are unique UUIDs
          - Tokens expire after 24 hours for security
          - Each token can only be used once
          - No indication if email doesn't exist (prevents user enumeration)
          
          ### Rate Limiting:
          - Limited to 3 requests per email per hour
          - Global rate limiting applied to prevent abuse
          
          ### Email Content:
          The email will contain:
          - Password reset link with token
          - User's full name for personalization
          - Token expiry information (24 hours)
          - Security notice about unsolicited requests
          
}

example {
  name: 200 Response
  description: Password reset email sent successfully
  
  request: {
    url: {{baseUrl}}/v1/auth/forgot-password/
    method: POST
    mode: json
    body:json: {
      {
        "email": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/forgot-password/
    method: POST
    mode: json
    body:json: {
      {
        "email": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "errors": {
            "email": [
              "Enter a valid email address."
            ]
          }
        }
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/forgot-password/
    method: POST
    mode: json
    body:json: {
      {
        "email": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "If an account exists with this email, a reset link has been sent."
        }
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/forgot-password/
    method: POST
    mode: json
    body:json: {
      {
        "email": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 429
      text: Too Many Requests
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Too many reset requests. Please try again in 1 hour."
        }
      '''
    }
  }
}
