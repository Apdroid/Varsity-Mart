meta {
  name: User Registration
  type: http
  seq: 7
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/v1/auth/register/
  body: json
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:json {
   {
    "email": "vision060607@gmail.com",
    "password": "test@123",
    "confirm_password": "test@123",
    "firstName": "Text",
    "phone": "+233 55 00000000",
    "university": "KNUST",
    "campus": "Main",
    "agree_to_terms": true,
    "lastName": "X"
  }
}

docs {
  
          Register a new user on VarsityMart.
  
          - **Student registration**: If `is_student` is `true`, `student_id` is required.
          - **Email domain**: Students must use a university email (containing `.edu`, `.edu.gh`, or `.ac.gh`). Disposable email domains are blocked.
          - **Verification**: A 6‑digit verification code is sent to the email address. The code expires after 24 hours.
          - **Authentication method**: Default is `credentials` (email + password). If `google` is used, the user is created without password (OAuth flow handled separately).
          - **Cookies**: On success, HTTP‑only cookies containing JWT tokens are set automatically.
  
          **Note:** Even if the verification email fails to send immediately, the registration is still considered successful and a background task will retry sending it.
          
}

example {
  name: 201 Response
  description: Registration successful (user created, cookies set)
  
  request: {
    url: {{baseUrl}}/v1/auth/register/
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "email": "",
        "password": "",
        "confirm_password": "",
        "firstName": "",
        "phone": "",
        "university": "",
        "campus": "",
        "agree_to_terms": false,
        "lastName": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/register/
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "email": "",
        "password": "",
        "confirm_password": "",
        "firstName": "",
        "phone": "",
        "university": "",
        "campus": "",
        "agree_to_terms": false,
        "lastName": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "errors": {
            "email": [
              "Enter a valid email address."
            ],
            "password": [
              "This password is too short."
            ],
            "confirmPassword": [
              "Passwords do not match."
            ],
            "studentId": [
              "Student ID is required for students."
            ],
            "agreeToTerms": [
              "You must agree to the terms and conditions."
            ]
          }
        }
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/register/
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "email": "",
        "password": "",
        "confirm_password": "",
        "firstName": "",
        "phone": "",
        "university": "",
        "campus": "",
        "agree_to_terms": false,
        "lastName": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "errors": {
            "email": [
              "user with this email address already exists."
            ],
            "phone": [
              "user with this phone number already exists."
            ]
          }
        }
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/register/
    method: POST
    mode: json
    headers: {
      access_token: {{apiKey}}
    }
  
    body:json: {
      {
        "email": "",
        "password": "",
        "confirm_password": "",
        "firstName": "",
        "phone": "",
        "university": "",
        "campus": "",
        "agree_to_terms": false,
        "lastName": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 500
      text: Internal Server Error
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Registration failed due to server error",
          "errors": {
            "non_field_errors": [
              "An unexpected error occurred"
            ]
          }
        }
      '''
    }
  }
}
