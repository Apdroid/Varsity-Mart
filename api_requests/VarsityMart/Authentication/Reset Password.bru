meta {
  name: Reset Password
  type: http
  seq: 9
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/v1/auth/reset-password/
  body: json
  auth: inherit
}

body:json {
  {
    "reset_token": "",
    "new_password": "",
    "confirm_password": ""
  }
}

docs {
  
          Reset user password using the token received via email.
          
          ### Requirements:
          1. Valid reset token from email link
          2. New password (minimum 8 characters)
          3. Password confirmation
          
          ### Security Features:
          - Token must be valid and not expired (24-hour validity)
          - Token can only be used once (single-use)
          - All existing sessions are invalidated after reset
          - Previous passwords cannot be reused
          - Strong password validation enforced
          
          ### Token Validation:
          The token is validated for:
          - Existence in database
          - Not expired (24 hours from creation)
          - Not previously used
          - Associated with valid user account
          
          ### After Successful Reset:
          1. User password is updated
          2. Reset token is marked as used
          3. All existing JWT refresh tokens are blacklisted
          4. User must login with new password
          
          ### Note:
          This endpoint does not require authentication since the user
          may not be logged in when resetting password.
          
}

example {
  name: 200 Response
  description: Password reset successful
  
  request: {
    url: {{baseUrl}}/v1/auth/reset-password/
    method: POST
    mode: json
    body:json: {
      {
        "reset_token": "",
        "new_password": "",
        "confirm_password": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/reset-password/
    method: POST
    mode: json
    body:json: {
      {
        "reset_token": "",
        "new_password": "",
        "confirm_password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "success": false,
            "errors": {
              "reset_token": [
                "This field is required."
              ]
            }
          },
          {
            "success": false,
            "errors": {
              "new_password": [
                "Password must be at least 8 characters."
              ]
            }
          },
          {
            "success": false,
            "errors": {
              "confirm_password": [
                "Passwords do not match."
              ]
            }
          },
          {
            "success": false,
            "errors": {
              "reset_token": [
                "Invalid or expired reset token."
              ]
            }
          },
          {
            "success": false,
            "errors": {
              "reset_token": [
                "This reset token has already been used."
              ]
            }
          },
          {
            "success": false,
            "errors": {
              "reset_token": [
                "Reset token has expired."
              ]
            }
          }
        ]
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/reset-password/
    method: POST
    mode: json
    body:json: {
      {
        "reset_token": "",
        "new_password": "",
        "confirm_password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 410
      text: Gone
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "errors": {
            "reset_token": [
              "Reset token has expired. Please request a new one."
            ]
          }
        }
      '''
    }
  }
}
