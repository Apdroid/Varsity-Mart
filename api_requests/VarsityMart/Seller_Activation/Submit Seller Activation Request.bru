meta {
  name: Submit Seller Activation Request
  type: http
  seq: 1
  tags: [
    Seller_Activation
  ]
}

post {
  url: {{baseUrl}}/v1/auth/become-a-seller/
  body: multipartForm
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:multipart-form {
  seller_type: 
  kyc_document_type: 
  kyc_document: @file()
  kyc_selfie: @file()
}

docs {
  
          Submit identity-verification (KYC) to become a seller on VarsityMart.
  
          ### Process:
          1. User must have a verified email before applying.
          2. The user's `kyc_status` is set to `pending` until an admin approves
             or rejects it.
          3. **No** Store or Restaurant record is created at this stage. After
             KYC approval the seller can create up to 2 listings without a
             store; beyond that they must create a Store via the dedicated
             create-store endpoint.
  
          ### Constraints:
          - A user with `kyc_status` of `pending` or `approved` cannot re-apply.
          - `seller_type` and `kyc_document_type` are recorded for admin review.
          - Send **`multipart/form-data`**. `kyc_document` (image of the ID card)
            and `kyc_selfie` (photo of the user holding the card) must be sent as
            file fields; they are uploaded to Cloudinary and their URLs are stored
            on the user record.
  
          **Accepted file types:** image formats supported by Django's
          `ImageField` (for example JPEG or PNG).
          
}

example {
  name: 201 Response
  description: Application submitted successfully
  
  request: {
    url: {{baseUrl}}/v1/auth/become-a-seller/
    method: POST
    mode: multipartForm
    headers: {
      access_token: {{apiKey}}
    }
  
    body:multipart-form: {
      seller_type: 
      kyc_document_type: 
      kyc_document: @file()
      kyc_selfie: @file()
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/become-a-seller/
    method: POST
    mode: multipartForm
    headers: {
      access_token: {{apiKey}}
    }
  
    body:multipart-form: {
      seller_type: 
      kyc_document_type: 
      kyc_document: @file()
      kyc_selfie: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Your seller application is already under review."
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided.
  
  request: {
    url: {{baseUrl}}/v1/auth/become-a-seller/
    method: POST
    mode: multipartForm
    headers: {
      access_token: {{apiKey}}
    }
  
    body:multipart-form: {
      seller_type: 
      kyc_document_type: 
      kyc_document: @file()
      kyc_selfie: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/auth/become-a-seller/
    method: POST
    mode: multipartForm
    headers: {
      access_token: {{apiKey}}
    }
  
    body:multipart-form: {
      seller_type: 
      kyc_document_type: 
      kyc_document: @file()
      kyc_selfie: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Please verify your email before becoming a seller."
        }
      '''
    }
  }
}
