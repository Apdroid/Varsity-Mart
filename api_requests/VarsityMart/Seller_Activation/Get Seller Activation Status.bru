meta {
  name: Get Seller Activation Status
  type: http
  seq: 2
  tags: [
    Seller_Activation
  ]
}

get {
  url: {{baseUrl}}/auth/seller-status/
  body: none
  auth: inherit
}

docs {
  
  Returns the seller-capability snapshot for the currently authenticated user.
  
  ### Response fields:
  - **kyc_status**: Current KYC review state (`none`, `pending`, `approved`, `rejected`).
  - **has_store**: Whether the user owns an active product store.
  - **has_restaurant**: Whether the user owns an active restaurant.
  - **seller_type**: Derived seller type — `products`, `food`, or `null` if not a seller yet.
  - **submitted_at**: ISO-8601 timestamp of the KYC submission, or `null` if not submitted.
  
}

example {
  name: 200 Response
  description: Seller status snapshot
  
  request: {
    url: {{baseUrl}}/auth/seller-status/
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided.
  
  request: {
    url: {{baseUrl}}/auth/seller-status/
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
