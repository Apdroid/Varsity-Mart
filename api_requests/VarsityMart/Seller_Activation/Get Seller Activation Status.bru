meta {
  name: Get Seller Activation Status
  type: http
  seq: 2
  tags: [
    Seller_Activation
  ]
}

get {
  url: {{baseUrl}}/v1/auth/seller-status/
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  
          Returns the seller-capability snapshot for the currently authenticated user.
  
          ### Response fields:
          - **kyc_status**: Current KYC review state
            (`not_submitted`, `pending`, `approved`, `rejected`).
          - **has_store**: Whether the user has created a Store
            (derived from actual ownership).
          - **has_restaurant**: Whether the user has created a Restaurant
            (derived from actual ownership).
          - **seller_type**: Derived seller type — `products` if the user owns
            a Store, `food` if they own a Restaurant, otherwise `null`. KYC
            itself no longer commits the user to a seller type; the type is
            inferred from what the user later creates.
          - **submitted_at**: ISO-8601 timestamp of the KYC submission, or
            `null` if not submitted.
          
}

example {
  name: 200 Response
  description: Seller status snapshot
  
  request: {
    url: {{baseUrl}}/v1/auth/seller-status/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided.
  
  request: {
    url: {{baseUrl}}/v1/auth/seller-status/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
