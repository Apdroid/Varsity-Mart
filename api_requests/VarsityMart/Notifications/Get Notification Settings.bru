meta {
  name: Get Notification Settings
  type: http
  seq: 5
  tags: [
    Notifications
  ]
}

get {
  url: {{baseUrl}}/v1/notifications/settings/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Get notification settings for the authenticated user
}

example {
  name: 200 Response
  description: Notification settings retrieved successfully
  
  request: {
    url: {{baseUrl}}/v1/notifications/settings/
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - Authentication required
  
  request: {
    url: {{baseUrl}}/v1/notifications/settings/
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
