meta {
  name: Get Notifications
  type: http
  seq: 1
  tags: [
    Notifications
  ]
}

get {
  url: {{baseUrl}}/v1/notifications/
  body: none
  auth: bearer
}

params:query {
  ~limit: 
  ~page: 
  ~unreadOnly: 
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieve notifications for the authenticated user with pagination and filtering
}

example {
  name: 200 Response
  description: List of notifications with pagination
  
  request: {
    url: {{baseUrl}}/v1/notifications/
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~unreadOnly: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  
  request: {
    url: {{baseUrl}}/v1/notifications/
    method: GET
    mode: none
    params:query: {
      ~limit: 
      ~page: 
      ~unreadOnly: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
