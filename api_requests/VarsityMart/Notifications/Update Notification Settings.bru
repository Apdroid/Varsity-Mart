meta {
  name: Update Notification Settings
  type: http
  seq: 6
  tags: [
    Notifications
  ]
}

put {
  url: {{baseUrl}}/v1/notifications/settings/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "order_updates": false,
    "new_messages": false,
    "promotions": false,
    "price_drops": false,
    "new_followers": false,
    "push_enabled": false,
    "email_enabled": false,
    "sms_enabled": false
  }
}

docs {
  Update notification settings for the authenticated user
}

example {
  name: 200 Response
  description: Notification settings updated successfully
  
  request: {
    url: {{baseUrl}}/v1/notifications/settings/
    method: PUT
    mode: json
    body:json: {
      {
        "order_updates": false,
        "new_messages": false,
        "promotions": false,
        "price_drops": false,
        "new_followers": false,
        "push_enabled": false,
        "email_enabled": false,
        "sms_enabled": false
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - Authentication required
  
  request: {
    url: {{baseUrl}}/v1/notifications/settings/
    method: PUT
    mode: json
    body:json: {
      {
        "order_updates": false,
        "new_messages": false,
        "promotions": false,
        "price_drops": false,
        "new_followers": false,
        "push_enabled": false,
        "email_enabled": false,
        "sms_enabled": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
