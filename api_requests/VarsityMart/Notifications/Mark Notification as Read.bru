        {}
      '''
    }
  }
}

example {
  name: Notification not found
  
  request: {
    url: {{baseUrl}}/v1/notifications/:notification_id/read/
    method: POST
    mode: none
    params:path: {
      notification_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Notification not found"
        }
      '''
    }
  }
}

