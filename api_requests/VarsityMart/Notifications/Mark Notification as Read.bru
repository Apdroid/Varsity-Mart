meta {
  name: Mark Notification as Read
  type: http
  seq: 3
  tags: [
    Notifications
  ]
}

post {
  url: {{baseUrl}}/v1/notifications/:notification_id/read/
  body: none
  auth: bearer
}

params:path {
  notification_id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  
  Mark a single notification as read for the current user.
  
  Only authenticated verified users can call this endpoint. `read=True` means the notification no
  longer counts towards unread badge totals in API responses. This endpoint is effectively
  idempotent; calling it repeatedly keeps the notification in read state.
          
}

example {
  name: 200 Response
  description: Notification marked as read successfully
  
  request: {
    url: {{baseUrl}}/v1/notifications/:notification_id/read/
    method: POST
    mode: none
    params:path: {
      notification_id: 
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

