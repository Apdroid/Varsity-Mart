meta {
  name: Mark All Notifications as Read
  type: http
  seq: 4
  tags: [
    Notifications
  ]
}

post {
  url: {{baseUrl}}/v1/notifications/read-all/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  
  Mark every unread notification as read for the current authenticated user.
  
  Scope is strictly the caller's own notification records; other users are unaffected.
  This is commonly used after opening the notifications screen to clear unread counters.
  The operation is not destructive and can be followed by new unread notifications later.
          
}

example {
  name: 200 Response
  description: All notifications marked as read
  
  request: {
    url: {{baseUrl}}/v1/notifications/read-all/
    method: POST
    mode: none
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  
  request: {
    url: {{baseUrl}}/v1/notifications/read-all/
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}
