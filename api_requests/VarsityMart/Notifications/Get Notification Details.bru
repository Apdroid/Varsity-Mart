meta {
  name: Get Notification Details
  type: http
  seq: 2
  tags: [
    Notifications
  ]
}

get {
  url: {{baseUrl}}/v1/notifications/:notification_id/
  body: none
  auth: bearer
}

params:path {
  notification_id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieve details of a specific notification by its UUID
}

example {
  name: 200 Response
  description: Notification details
  
  request: {
    url: {{baseUrl}}/v1/notifications/:notification_id/
    method: GET
    mode: none
    params:path: {
      notification_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "user_id": "",
          "title": "",
          "body": "",
          "data": "",
          "read": false,
          "notification_type": "general",
          "sent": false,
          "created_at": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  
  request: {
    url: {{baseUrl}}/v1/notifications/:notification_id/
    method: GET
    mode: none
    params:path: {
      notification_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Not Found
  
  request: {
    url: {{baseUrl}}/v1/notifications/:notification_id/
    method: GET
    mode: none
    params:path: {
      notification_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "Notification not found"
        }
      '''
    }
  }
}
