meta {
  name: List Pending KYC Applications
  type: http
  seq: 2
  tags: [
    Admin_KYC_Review
  ]
}

get {
  url: {{baseUrl}}/v1/admin/kyc/pending/
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  
          Returns every user whose KYC review is currently in `pending` state,
          ordered by submission time (oldest first).
  
          ### Notes:
          - Requires **staff / admin** credentials.
          - `seller_type` is derived from any Store / Restaurant the user
            already owns (`products` / `food`). At first-time KYC the user
            will not own anything yet, so this field is typically `null`
            during review — the seller type chosen on the application form
            is informational and is not persisted.
          - `kyc_document_type` is always `null` until a dedicated KYC
            submission model is added; clients should degrade gracefully.
          
}

example {
  name: 200 Response
  description: List of pending KYC applicants
  
  request: {
    url: {{baseUrl}}/v1/admin/kyc/pending/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication credentials were not provided.
  
  request: {
    url: {{baseUrl}}/v1/admin/kyc/pending/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

