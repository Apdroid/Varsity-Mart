  ]
}

get {
  url: {{baseUrl}}/v1/orders/:orderId
  body: none
  auth: apikey
}

params:path {
  orderId: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

