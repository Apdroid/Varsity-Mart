meta {
  name: Delete User Avatar
  type: http
  seq: 19
  tags: [
    v1
  ]
}

delete {
  url: {{baseUrl}}/v1/users/me/avatar/delete/
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  
          Delete current user's profile avatar from Cloudinary and revert to default.
          
          ### What Happens:
          1. Current avatar is deleted from Cloudinary storage
          2. User's profile_pic field is set to null
          3. System reverts to default generated avatar
          
          ### Cloudinary Cleanup:
          - Image is permanently deleted from Cloudinary
          - Public ID: `user_avatar_{user_id}`
          - Folder: `user_avatars`
          
          ### Important Notes:
          - This action cannot be undone
          - File is permanently deleted from Cloudinary
          - No backup is kept
          
}

example {
  name: 204 Response
  description: No response body
  
  request: {
    url: {{baseUrl}}/v1/users/me/avatar/delete/
    method: DELETE
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
