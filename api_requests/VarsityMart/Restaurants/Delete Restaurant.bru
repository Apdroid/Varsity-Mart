    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Restaurant not found
  
  request: {
    url: {{baseUrl}}/v1/restaurants/:id/
    method: DELETE
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  }
  
