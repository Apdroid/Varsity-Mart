meta {
  name: Create Restaurant
  type: http
  seq: 2
  tags: [
    Restaurants
  ]
}

post {
  url: {{baseUrl}}/v1/restaurants/
  body: multipartForm
  auth: apikey
}

params:path {
  id: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:multipart-form {
  restaurantName: 
  description: 
  category: 
  logo: 
  banner: 
  location: 
  phone: 
  openingTime: 
  closingTime: 
  deliveryFee: 
  deliveryTime: 
  minOrder: 
  restaurantId: 
  paymentRequired: 
  amount: 
  kycRequired: 
  paymentUrl: 
  campus: 
  university: 
}

docs {
  Create a new restaurant. Requires authentication. After creation, complete KYC and payment process.
}

example {
  name: 201 Response
  description: Restaurant created successfully
  
  request: {
    url: {{baseUrl}}/v1/restaurants/
    method: POST
    mode: multipartForm
    params:path: {
      id: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:multipart-form: {
      restaurantName: 
      description: 
      category: 
      logo: 
      banner: 
      location: 
      phone: 
      openingTime: 
      closingTime: 
      deliveryFee: 
      deliveryTime: 
      minOrder: 
      restaurantId: 
      paymentRequired: 
      amount: 
      kycRequired: 
      paymentUrl: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Restaurant created successfully. Please complete payment and KYC.",
          "data": {}
        }
      '''
    }
  }
}

