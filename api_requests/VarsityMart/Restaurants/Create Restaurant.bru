  description: Authentication credentials were not provided
  
  request: {
    url: {{baseUrl}}/v1/restaurants/
    method: POST
    mode: multipartForm
    params:path: {
      id: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:multipart-form: {
      restaurantName: 
      description: 
      category: 
      logo: 
      banner: 
      location: 
      phone: 
      openingTime: 
      closingTime: 
      deliveryFee: 
      deliveryTime: 
