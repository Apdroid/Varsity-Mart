meta {
  name: Update Restaurant
  type: http
  seq: 4
  tags: [
    Restaurants
  ]
}

put {
  url: {{baseUrl}}/v1/restaurants/:id/
  body: multipartForm
  auth: apikey
}

params:path {
  id: 
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

body:multipart-form {
  restaurantName: 
  description: 
  category: 
  logo: 
  banner: 
  location: 
  phone: 
  openingTime: 
  closingTime: 
  deliveryFee: 
  deliveryTime: 
  minOrder: 
  restaurantId: 
  paymentRequired: 
  amount: 
  kycRequired: 
  paymentUrl: 
}

docs {
  Update restaurant details. Only the restaurant owner can update their restaurant. Supports both full (PUT) and partial (PATCH) updates.
}

example {
  name: 200 Response
  description: Restaurant updated successfully
  
  request: {
    url: {{baseUrl}}/v1/restaurants/:id/
    method: PUT
    mode: multipartForm
    params:path: {
      id: 
    }
  
    headers: {
      access_token: {{apiKey}}
    }
  
    body:multipart-form: {
      restaurantName: 
      description: 
      category: 
      logo: 
      banner: 
      location: 
      phone: 
      openingTime: 
      closingTime: 
      deliveryFee: 
      deliveryTime: 
      minOrder: 
      restaurantId: 
      paymentRequired: 
      amount: 
      kycRequired: 
      paymentUrl: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Restaurant updated successfully",
          "data": {}
        }
      '''
    }
  }
}

