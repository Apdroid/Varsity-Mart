meta {
  name: Delete Store
  type: http
  seq: 6
  tags: [
    Stores
  ]
}

delete {
  url: {{baseUrl}}/v1/stores/:id/
  body: none
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

docs {
  
  ### Delete Store
  
  Deletes a store owned by the authenticated user.
  
  **Requirements:**
  - Must be the store owner
  
  **Options:**
  - `deleteProducts: true` — permanently deletes all products in the store
  - `deleteProducts: false` (default) — converts store products to general marketplace products
          
}

