meta {
  name: Partially Update Store
  type: http
  seq: 5
  tags: [
    Stores
  ]
}

patch {
  url: {{baseUrl}}/v1/stores/:id/
  body: multipartForm
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  storeName: 
  description: 
  category: 
  location: 
  phone: 
  openingTime: 
  closingTime: 
  deliveryFee: 
  minOrder: 
  logo: @file()
  banner: @file()
}

docs {
  
  ### Partially Update Store
  
  Updates specific fields of a store. Only provided fields are modified.
  
  **Supports image uploads:** `logo` and `banner` fields accept image files.
          
}

example {
  name: 200 Response
  description: Store updated successfully
  
  request: {
    url: {{baseUrl}}/v1/stores/:id/
    method: PATCH
    mode: multipartForm
    params:path: {
      id: 
    }
  
    body:multipart-form: {
      storeName: 
      description: 
      category: 
      location: 
      phone: 
      openingTime: 
      closingTime: 
      deliveryFee: 
      minOrder: 
      logo: @file()
      banner: @file()
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

