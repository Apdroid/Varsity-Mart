meta {
  name: Create Store
  type: http
  seq: 2
  tags: [
    Stores
  ]
}

post {
  url: {{baseUrl}}/v1/stores/
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  storeName: Campus Essentials
  description: 
  category: 
  location: Main Campus
  phone: +233501234567
  openingTime: 08:00:00
  closingTime: 20:00:00
  deliveryFee: 5
  minOrder: 10
  logo: @file()
  banner: @file()
  migrateProducts: false
}

docs {
  
  ### Create a New Store
  
  Creates a new store for the authenticated user.
  
  **Required fields:** `storeName`, `description`, `category`, `location`, `deliveryFee`, `minOrder`
  
  **Optional fields:** `logo` (image), `banner` (image), `phone`, `openingTime`, `closingTime`
  
  **Features:**
  - Upload logo and banner images (uploaded to Cloudinary)
  - Optionally migrate existing products to the new store with `migrateProducts: true`
  - Payment details are auto-generated after creation
          
}

example {
  name: 201 Response
  description: Store created successfully
  
  request: {
    url: {{baseUrl}}/v1/stores/
    method: POST
    mode: multipartForm
    body:multipart-form: {
      storeName: Campus Essentials
      description: 
      category: 
      location: Main Campus
      phone: +233501234567
      openingTime: 08:00:00
      closingTime: 20:00:00
      deliveryFee: 5
      minOrder: 10
      logo: @file()
      banner: @file()
      migrateProducts: false
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

