meta {
  name: List All Stores
  type: http
  seq: 1
  tags: [
    Stores
  ]
}

get {
  url: {{baseUrl}}/v1/stores/?page=2
  body: none
  auth: inherit
}

params:query {
  page: 2
  ~category: 
  ~limit: 
  ~search: 
  ~sortBy: newest
  ~sortBy: popular
}

docs {
  
  ### List All Stores
  
  Returns a paginated list of all stores.
  
  **Features:**
  - Filter by **category** name
  - **Search** by store name or description
  - **Sort** by popularity or newest
  - Paginated results with configurable page size
          
}

