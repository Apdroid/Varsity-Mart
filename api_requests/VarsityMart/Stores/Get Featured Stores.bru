meta {
  name: Get Featured Stores
  type: http
  seq: 10
  tags: [
    Stores
  ]
}

get {
  url: {{baseUrl}}/v1/stores/featured/
  body: none
  auth: apikey
}

headers {
  access_token: {{apiKey}}
}

auth:apikey {
  key: access_token
  value: {{apiKey}}
  placement: header
}

docs {
  
  ### Get Featured Stores
  
  Returns up to 10 stores that are featured in their respective categories.
  No authentication required.
          
}

example {
  name: 200 Response
  description: Featured stores retrieved successfully
  
  request: {
    url: {{baseUrl}}/v1/stores/featured/
    method: GET
    mode: none
    headers: {
      access_token: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
