meta {
  name: Unregister Device
  type: http
  seq: 2
  tags: [
    Devices
  ]
}

delete {
  url: {{baseUrl}}/v1/devices/register/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Unregister a device by device_id or fcm_token. At least one parameter is required.
}

example {
  name: 200 Response
  description: Device unregistered successfully
  
  request: {
    url: {{baseUrl}}/v1/devices/register/
    method: DELETE
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Device unregistered successfully"
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Bad Request
  
  request: {
    url: {{baseUrl}}/v1/devices/register/
    method: DELETE
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "device_id or fcm_token is required"
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - Authentication required
  
  request: {
    url: {{baseUrl}}/v1/devices/register/
    method: DELETE
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": ""
        }
      '''
    }
  }
}
