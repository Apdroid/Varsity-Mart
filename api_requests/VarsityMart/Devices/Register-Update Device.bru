meta {
  name: Register/Update Device
  type: http
  seq: 1
  tags: [
    Devices
  ]
}

post {
  url: {{baseUrl}}/v1/devices/register/
  body: json
  auth: bearer
}

headers {
  Authorization: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "id": "",
    "user_id": "",
    "fcm_token": "",
    "token_type": "",
    "device_type": "web",
    "device_id": "",
    "is_active": false,
    "created_at": ""
  }
}

docs {
  
          Register a new device or update existing device with push notification token.
          
          **Token Type Detection:**
          - For iOS devices, the system automatically detects APN tokens based on format:
            - 64-character hexadecimal strings (traditional APN tokens)
            - Strings starting with 'APNS' (newer APN tokens)
          - All other devices use FCM tokens by default
          
          **Note:** The frontend continues to send 'fcm_token' field for all devices.
          The backend automatically determines if it's an FCM or APN token based on format.
          
}

example {
  name: application/json Example
  
  request: {
    url: {{baseUrl}}/v1/devices/register/
    method: POST
    mode: json
    headers: {
      Authorization: 
    }
  
    body:json: {
      {
        "id": "",
        "user_id": "",
        "fcm_token": "",
        "token_type": "",
        "device_type": "web",
        "device_id": "",
        "is_active": false,
        "created_at": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "user_id": "123e4567-e89b-12d3-a456-426614174001",
          "fcm_token": "fcm_or_apn_token_here",
          "token_type": "fcm",
          "device_type": "ios",
          "device_id": "iphone_12_user123",
          "is_active": true,
          "created_at": "2024-01-15T10:30:00Z"
        }
      '''
    }
  }
}

