NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend API base (browser-exposed — the app talks to it directly, no proxy)
NEXT_PUBLIC_API_URL=https://api.varsitymart.org/v1
# WebSocket host for chat (no /v1 suffix — Channels routes /ws/* at the root)
NEXT_PUBLIC_WS_URL=wss://api.varsitymart.org
