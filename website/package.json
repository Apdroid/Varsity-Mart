{
  "name": "varsitymart_webapp",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript openapi/varsitymart_api.json -o lib/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:api": "curl -fsS --max-time 120 \"https://api.varsitymart.org/schema/?format=json&lang=en\" -o openapi/varsitymart_api.json && bun run gen:api"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@lobehub/icons": "^5.23.1",
    "@phosphor-icons/react": "^2.1.10",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-devtools": "^5.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-data-list": "^1.6.3",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.15",
    "motion": "^12.43.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-circle-flags": "^0.0.29",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.16.1",
    "recharts": "3.8.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.9.0"
  }
}
